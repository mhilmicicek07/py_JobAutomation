# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Production için PostgreSQL)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# AI Provider Settings (Global fallback - kullanıcı ayarları önceliklidir)
AI_PROVIDER=openai
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MODEL_CV=gpt-4o-mini
OPENAI_MODEL_POSTING=gpt-4o-mini
OPENAI_MODEL_LETTER=gpt-4o-mini

# AI Cover Letter Provider
AI_COVER_LETTER_PROVIDER=openai

# Job Match Thresholds
JOB_MATCH_THRESHOLD_APPLY=80
JOB_MATCH_THRESHOLD_REVIEW=50

# Email Settings (Production)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Security (Production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# Cache (Production için Redis)
# CACHES_BACKEND=django.core.cache.backends.redis.RedisCache
# REDIS_URL=redis://127.0.0.1:6379/1

# Logging
# LOG_LEVEL=INFO
# LOG_FILE_PATH=logs/django.log
